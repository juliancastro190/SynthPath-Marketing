# Copy this file to .env and fill in your keys. .env is git-ignored.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional overrides — uncomment to change defaults.
# GRIFFIN_MODEL=claude-sonnet-5
# GRIFFIN_NAME=Griffin

# Tier 3 — voice
DEEPGRAM_API_KEY=your-deepgram-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# Defaults to ElevenLabs' premade "Rachel" voice until you pick one.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Which key to hold to talk: ctrl_r, ctrl_l, alt_r, alt_l, or space.
# GRIFFIN_PTT_KEY=ctrl_r

# Tier 7 — Etsy selling
# Your Etsy app's keystring (developer.etsy.com -> Your Apps). This is not
# a per-user secret by itself — run `python3 etsy_connect.py` once after
# setting this to actually authorize a shop; that saves a refresh token to
# data/etsy_token.json, which is what Griffin actually acts with.
ETSY_API_KEY=your-etsy-keystring-here
# Your shop's numeric id (Shop Manager -> Settings -> Options, or in your
# shop's URL).
ETSY_SHOP_ID=your-etsy-shop-id-here
