# Copy this file to .env and fill in your keys. .env is git-ignored.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional overrides — uncomment to change defaults.
# GRIFFIN_MODEL=claude-sonnet-5
# GRIFFIN_NAME=Griffin

# Tier 3 — voice
DEEPGRAM_API_KEY=your-deepgram-api-key-here
# Which key to hold to talk: ctrl_r, ctrl_l, alt_r, alt_l, or space.
# GRIFFIN_PTT_KEY=ctrl_r

# Text-to-speech: "local" (default) uses the OS's own speech engine via
# pyttsx3 — free, offline, no account needed. "elevenlabs" sounds more
# natural but needs a paid ElevenLabs plan (every voice 402s on the free
# tier's API, including the old defaults).
# TTS_PROVIDER=local
# Optional: substring to match an installed local voice's name (Windows
# example: "David"). Leave unset to auto-guess a male-sounding voice.
# LOCAL_TTS_VOICE=
# Only used when TTS_PROVIDER=elevenlabs:
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Discord bridge (see DEPLOY.md) — not needed for the text/voice interfaces.
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_OWNER_ID=your-discord-user-id-here
