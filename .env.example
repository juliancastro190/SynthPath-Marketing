# Copy this file to .env and fill in your keys. .env is git-ignored.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional overrides — uncomment to change defaults.
# GRIFFIN_MODEL=claude-sonnet-5
# GRIFFIN_NAME=Griffin

# Tier 3 — voice
DEEPGRAM_API_KEY=your-deepgram-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# Defaults to ElevenLabs' premade "Rachel" voice until you pick one.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Which key to hold to talk: ctrl_r, ctrl_l, alt_r, alt_l, or space.
# GRIFFIN_PTT_KEY=ctrl_r

# Discord bridge (see DEPLOY.md) — not needed for the text/voice interfaces.
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_OWNER_ID=your-discord-user-id-here

# Tier 7 — optional: proxy model calls through Helicone (helicone.ai) so
# Griffin's and every specialist's activity shows up as a live trace in a
# web dashboard. Leave unset to talk to Anthropic directly, unchanged.
# HELICONE_API_KEY=your-helicone-api-key-here

# Tier 7 — youtube specialist's Reddit story sourcing. Recommended: Reddit
# increasingly 403s unauthenticated requests to its JSON endpoints, so
# without these, story fetching is unreliable. Get a free "script" app at
# https://www.reddit.com/prefs/apps ("create app" -> type: script; the
# redirect URI field is required but unused for this, put anything like
# http://localhost). No Reddit login/password is used at runtime — just
# the client ID (under the app name) and secret it gives you.
# REDDIT_CLIENT_ID=your-reddit-app-client-id-here
# REDDIT_CLIENT_SECRET=your-reddit-app-client-secret-here
